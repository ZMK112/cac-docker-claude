# Generated by cac-docker setup — no need to edit manually.

# ── Proxy (required) ────────────────────────────────────────────────
# Share link:  ss://..., vmess://..., vless://..., trojan://...
# Compact:     ip:port  or  ip:port:user:pass
# PROXY_URI=

# ── Deploy mode (auto-detected) ─────────────────────────────────────
# DEPLOY_MODE=remote     # remote=macvlan, local=bridge

# ── Macvlan (auto-detected, remote only) ─────────────────────────────
# HOST_INTERFACE=eth0
# MACVLAN_SUBNET=192.168.1.0/24
# MACVLAN_GATEWAY=192.168.1.1
# MACVLAN_IP=192.168.1.200
# SHIM_IP=192.168.1.201

# ── Data (persistent storage) ────────────────────────────────────────
# CAC_DATA=./data      # host directory for /root and /home
# /workspace is auto-mounted from the current working directory when you run `cac docker start`
# CAC_CONTAINER_DOCKER_HOST=tcp://engine-gateway:2375
# CAC_DOCKER_PROXY_IP=172.31.255.2
# CAC_DOCKER_CLIENT_IP=172.31.255.3
# CAC_CHILD_PROXY_BRIDGE_IP=172.31.255.4
# CAC_DOCKER_CONTROL_SUBNET=172.31.255.0/24
# CAC_DOCKER_PROXY_NAME=engine-gateway
# CAC_CONTAINER_RUNTIME_HOSTNAME=studio-main
# CAC_ENABLE_SSH=1
# CAC_HOST_SSH_BIND=127.0.0.1   # set 0.0.0.0 only when LAN access is explicitly required
# CAC_HOST_SSH_PORT=2222
# CAC_SSH_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# CAC_ENABLE_WEB=1
# CAC_WEB_PORT=3001
# CAC_HOST_WEB_BIND=127.0.0.1   # WARNING: 0.0.0.0 exposes the no-login Web UI to your LAN
# CAC_HOST_WEB_PORT=3001
# CAC_SHM_SIZE=2g
# CAC_CHILD_CONTAINER_NETWORK_MODE=bridge
# CAC_CHILD_PROXY_BRIDGE_BIND=0.0.0.0   # child proxy bridge listen bind; 0.0.0.0 keeps child containers working across Docker modes
# CAC_CHILD_PROXY_BRIDGE_PORT=17891
# CAC_CHILD_PROXY_BRIDGE_USER=cacbridge
# CAC_CHILD_PROXY_BRIDGE_PASSWORD=REPLACE_WITH_RANDOM_BRIDGE_PASSWORD
# CAC_CHILD_CONTAINER_PROXY_URL=socks5h://<user>:<pass>@host.docker.internal:<bridge-port>
# CAC_CHILD_CONTAINER_HTTP_PROXY_URL=http://<user>:<pass>@host.docker.internal:<bridge-port>
# CAC_CHILD_CONTAINER_ALL_PROXY_URL=socks5h://<user>:<pass>@host.docker.internal:<bridge-port>

# ── Optional ─────────────────────────────────────────────────────────
# SINGBOX_ENABLE=1
# DNS_SERVER=https://1.1.1.1/dns-query
# TUN_ADDRESS=172.19.0.1/30
# TUN_MTU=9000
# DISABLE_IPV6=1
# CAC_NET_TUNING=0                 # set 1 to apply optional TCP tuning inside the privileged container
# CAC_NET_TUNING_BBR=auto          # auto enables BBR only when the Docker VM kernel supports it
# CAC_TCP_FASTOPEN=3
# CAC_TCP_MTU_PROBING=1
# CAC_TCP_KEEPALIVE_TIME=600
# CAC_TCP_KEEPALIVE_INTVL=30
# CAC_TCP_KEEPALIVE_PROBES=5
# HEALTHCHECK=1
# CAC_CHILD_CONTAINER_NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal
