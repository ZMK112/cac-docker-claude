items = []
if os.path.exists(state_path):
    with open(state_path, "r", encoding="utf-8") as fh:
        items = json.load(fh)
    if not isinstance(items, list):
        raise SystemExit("mounts.json must contain a list")

if not items:
    if os.path.exists(compose_path):
        os.remove(compose_path)
    raise SystemExit(0)

