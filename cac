    fh.write("services:\n")
    fh.write("  cac:\n")
    fh.write("    volumes:\n")
    for item in sorted(items, key=lambda x: x["container_path"]):
        fh.write("      - type: bind\n")
        fh.write(f"        source: {json.dumps(item['host_path'])}\n")
        fh.write(f"        target: {json.dumps(item['container_path'])}\n")
        fh.write("        read_only: false\n")
PY
}

