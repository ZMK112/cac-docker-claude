    [[ ! -e "${backup_dir}/docker-state/docker-compose.mounts.yml" && ! -e "${backup_dir}/docker-dir/docker-compose.mounts.yml" ]] || [[ -e "${docker_dir}/docker-compose.mounts.yml" ]] || return 1
}

_self_restore_state_from_backup() {
